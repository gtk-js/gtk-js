{
  "name": "gtk-js",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*",
    "icons/*",
    "themes/*",
    "tests"
  ],
  "scripts": {
    "dev": "vp run --filter @gtk-js/website dev",
    "build:packages": "vp run --filter '@gtk-js/*' --filter '!@gtk-js/website' build",
    "build": "vp run -r build",
    "test": "vp test",
    "check": "biome check . && tsc --noEmit && tsc --noEmit -p packages/website",
    "fix": "biome check . --write",
    "update-upstream": "node scripts/update-upstream.ts",
    "publish": "vp run build:packages && node scripts/publish.ts"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.4.10",
    "@types/node": "^22",
    "typescript": "^6.0.2",
    "vite-plus": "^1.2.0"
  },
  "packageManager": "npm@11.21.1"
}
