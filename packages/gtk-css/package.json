{
  "name": "@gtk-js/gtk-css",
  "publishConfig": {
    "access": "public"
  },
  "version": "0.1.2",
  "type": "module",
  "main": "dist/index.js",
  "files": [
    "dist",
    "src"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./build": "./src/build.ts",
    "./compile": "./src/compile.ts"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json && bun build src/index.ts --outdir dist --format esm --packages external"
  },
  "dependencies": {
    "postcss": "^8.5.8",
    "sass": "^1.99.0"
  }
}
