{
  "name": "@gtk-js/icon-helpers",
  "publishConfig": {
    "access": "public"
  },
  "version": "0.1.2",
  "type": "module",
  "main": "dist/index.js",
  "files": [
    "dist",
    "src"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./build": "./src/build-helpers.ts"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json && bun build src/index.ts --outdir dist --format esm --packages external"
  },
  "peerDependencies": {
    "react": "^18 || ^19"
  },
  "devDependencies": {
    "@types/react": "^19"
  }
}
