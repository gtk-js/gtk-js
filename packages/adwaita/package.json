{
  "name": "@gtk-js/adwaita",
  "publishConfig": {
    "access": "public"
  },
  "version": "0.1.8",
  "type": "module",
  "main": "dist/index.js",
  "files": [
    "dist",
    "src"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./adwaita.css": "./dist/adwaita.css"
  },
  "scripts": {
    "build": "bun build.ts && tsc -p tsconfig.build.json && NODE_ENV=production bun build src/index.ts --outdir dist --format esm --packages external"
  },
  "dependencies": {
    "@gtk-js/icons-adwaita": "0.1.6",
    "@gtk-js/gtk4": "0.1.8",
    "@gtk-js/theme-adwaita": "0.0.8"
  },
  "devDependencies": {
    "@gtk-js/gtk-css": "0.1.7",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3"
  },
  "peerDependencies": {
    "react": "^18 || ^19",
    "react-dom": "^18 || ^19"
  }
}
