{
  "name": "@gtk-js/theme-fluent",
  "publishConfig": {
    "access": "public"
  },
  "version": "0.0.4",
  "main": "dist/index.js",
  "files": [
    "dist",
    "src"
  ],
  "dependencies": {
    "@gtk-js/gtk-css": "workspace:*"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "bun build.ts && tsc -p tsconfig.build.json && bun build src/index.ts --outdir dist --format esm --packages external"
  },
  "type": "module"
}
